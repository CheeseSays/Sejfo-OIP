      "attribute": true,
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1,
      "label": "End A closed",
      "group": "State",
      "desc": "1 puts a floor across the -Z end: what an end with its flaps shut is, to anything set in the case. A machine sets this with End A fold stage 6."
